# ═══════════════════════════════════════════════════════════════════════════════
# Tilak Global School — Root .gitignore
# This repo tracks: frontend/ + admin/ + nginx/ + root config files
# backend/ is a SEPARATE git repo — fully ignored here
# ═══════════════════════════════════════════════════════════════════════════════

# ── Separate repos ─────────────────────────────────────────────────────────────
# backend/ has its own Git repo (Tilak-Global-School-Backend)
backend/

# ── Dependencies ───────────────────────────────────────────────────────────────
# Root and all subdirectory node_modules
node_modules/
**/node_modules/

# ── Next.js build output ───────────────────────────────────────────────────────
.next/
**/.next/
out/
**/out/

# ── Environment files ──────────────────────────────────────────────────────────
# .env.example IS committed — it is a safe template with no secrets
# Everything else is ignored
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# ── Uploads ────────────────────────────────────────────────────────────────────
uploads/
**/uploads/

# ── Build & cache ──────────────────────────────────────────────────────────────
.turbo/
**/.turbo/
.cache/
**/.cache/
*.tsbuildinfo

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
Desktop.ini

# ── Editors ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Misc ───────────────────────────────────────────────────────────────────────
*.pem
.vercel
