# Admin Panel — Environment Variables
# Copy this file to .env.local for local development.
# On Vercel: add in Project Settings → Environment Variables.
#
# NO NEXT_PUBLIC_ prefix — this variable is server-side only.
# Client-side code uses relative '/api/' URLs (Vercel rewrite proxies them).

# Full backend URL — used by Server Components only
API_URL=https://tilak-global-school-backend.onrender.com/api

# Development override (uncomment when working locally)
# API_URL=http://localhost:5000/api
